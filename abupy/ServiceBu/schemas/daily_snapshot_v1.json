{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abupy.local/schemas/daily_snapshot_v1.json",
  "title": "ABu daily snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "snapshot_id", "stream_id", "sequence_no", "trading_session",
    "decision_cutoff", "created_at", "universe_version", "calendar_version",
    "security_master_version", "raw_price_version", "adjusted_price_version",
    "industry_version", "valuation_version", "fundamental_pit_version",
    "corporate_action_version", "limit_reference_version", "required_components",
    "missing_components", "quality_codes", "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "daily_snapshot_v1"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "stream_id": {"type": "string", "pattern": "^market-daily:[0-9]{8}$"},
    "sequence_no": {"type": "integer", "minimum": 1},
    "previous_snapshot_id": {"type": ["string", "null"]},
    "trading_session": {"type": "integer"},
    "decision_cutoff": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "universe_version": {"type": "string"},
    "calendar_version": {"type": "string"},
    "security_master_version": {"type": "string"},
    "raw_price_version": {"type": "string"},
    "adjusted_price_version": {"type": "string"},
    "industry_version": {"type": "string"},
    "valuation_version": {"type": "string"},
    "fundamental_pit_version": {"type": "string"},
    "corporate_action_version": {"type": "string"},
    "limit_reference_version": {"type": "string"},
    "required_components": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "missing_components": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "quality_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "examples": [
    {
      "schema_version": "daily_snapshot_v1",
      "snapshot_id": "daily-20261009",
      "stream_id": "market-daily:20261009",
      "sequence_no": 1,
      "previous_snapshot_id": null,
      "trading_session": 20261009,
      "decision_cutoff": "2026-10-09T18:00:00+08:00",
      "created_at": "2026-10-09T18:05:00+08:00",
      "universe_version": "universe-v1",
      "calendar_version": "calendar-v1",
      "security_master_version": "security-v1",
      "raw_price_version": "raw-v1",
      "adjusted_price_version": "adjusted-v1",
      "industry_version": "industry-v1",
      "valuation_version": "valuation-v1",
      "fundamental_pit_version": "fundamental-v1",
      "corporate_action_version": "actions-v1",
      "limit_reference_version": "limits-v1",
      "required_components": ["raw_price", "adjusted_price", "universe"],
      "missing_components": [],
      "quality_codes": [],
      "manifest_sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
    }
  ]
}
