{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abupy.local/schemas/factor_snapshot_v1.json",
  "title": "ABu factor snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "snapshot_id", "stream_id", "sequence_no",
    "previous_snapshot_id", "trading_session", "decision_cutoff", "created_at",
    "strategy_id", "factor_set_version", "source_snapshot_id",
    "required_components", "factor_payload_sha256", "factor_payload_path", "quality_codes",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "factor_snapshot_v1"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "stream_id": {"type": "string", "pattern": "^factor:[a-zA-Z0-9_.-]+:[0-9]{8}$"},
    "sequence_no": {"type": "integer", "minimum": 1},
    "previous_snapshot_id": {"type": ["string", "null"]},
    "trading_session": {"type": "integer"},
    "decision_cutoff": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "strategy_id": {"type": "string", "minLength": 1},
    "factor_set_version": {"type": "string", "minLength": 1},
    "source_snapshot_id": {"type": "string", "minLength": 1},
    "required_components": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "factor_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "factor_payload_path": {"type": "string", "minLength": 1},
    "quality_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "examples": [
    {
      "schema_version": "factor_snapshot_v1",
      "snapshot_id": "factor-vcp-20261009",
      "stream_id": "factor:vcp:20261009",
      "sequence_no": 1,
      "previous_snapshot_id": null,
      "trading_session": 20261009,
      "decision_cutoff": "2026-10-09T18:00:00+08:00",
      "created_at": "2026-10-09T18:05:00+08:00",
      "strategy_id": "vcp",
      "factor_set_version": "vcp-factors-v1",
      "source_snapshot_id": "daily-20261009",
      "required_components": ["adjusted_price", "raw_price"],
      "factor_payload_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "factor_payload_path": "/immutable/factor-payload.json",
      "quality_codes": [],
      "manifest_sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
    }
  ]
}
